<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/rounded_dialog_bg">

    <TextView
        android:id="@+id/dialog_title_github_token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save GitHub Token"
        android:textColor="#C2C2C2"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/github_instructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#A8A8A8"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.2"
                android:text="To enable committing and pushing code to GitHub, please generate a Personal Access Token (PAT) with minimal necessary permissions:\n\n• For Fine-Grained Tokens:\nRepository Permissions -> Contents: Read and Write\n\n• For Classic Tokens:\nScopes -> repo (for private &amp; public) or public_repo" />

            <TextView
                android:id="@+id/github_token_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Generate GitHub Token here"
                android:textColor="#0366d6"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter GitHub Token"
        app:boxStrokeColor="#C2C2C2"
        app:hintTextColor="#C2C2C2"
        android:id="@+id/edit_text_lay_github_token"
        app:boxBackgroundMode="outline">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_github_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:inputType="textNoSuggestions"
            android:textColor="#ffffff"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel_github_token"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#C2C2C2"
            android:text="Cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save_github_token"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#C2C2C2"
            android:layout_marginStart="8dp"
            android:text="Save" />
    </LinearLayout>
</LinearLayout>